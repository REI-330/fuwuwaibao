      "level": 0,
      "text": "from ultralytics import YOLO\n\n# Load a model\nmodel = YOLO(\"yolo26n.pt\") # load an official model\nmodel = YOLO(\"path/to/best.pt\") # load a custom-trained model\n\n# Export the model\nmodel.export(format=\"onnx\")"
    },
