# DeepEval 评测的模型配置模板
#
# 用法：复制为同目录下的 .env，填入真实值（.env 不要提交到版本库）
#     cp knowledge/eval/.env.example knowledge/eval/.env
#
# 为什么需要它：deepeval 4.2.3 共 56 个指标类，其中 43 个在源码里直接调用 LLM；
# 与本任务相关的检索/答案类指标（Contextual Precision/Recall/Relevancy、
# Faithfulness、AnswerRelevancy）全部属于这 43 个。不接 LLM 只能跑
# ExactMatchMetric / PatternMatchMetric，对 RAG 评估没有意义。
#
# 本机已实测可达的国内端点（直连，无需代理）：
#   api.deepseek.com        HTTP 401  0.15s
#   dashscope.aliyuncs.com  HTTP 404  0.27s
#   api.moonshot.cn         HTTP 200  0.32s
#   open.bigmodel.cn        HTTP 200  0.25s
#   api.siliconflow.cn      HTTP 404  0.61s
#
# 填哪家就把三行换成哪家的 base_url 与模型名。

# --- DeepSeek（默认）---
DEEPEVAL_BASE_URL=https://api.deepseek.com/v1
DEEPEVAL_API_KEY=
DEEPEVAL_MODEL=deepseek-chat

# --- 通义千问 DashScope 兼容模式 ---
# DEEPEVAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPEVAL_MODEL=qwen-plus

# --- 月之暗面 ---
# DEEPEVAL_BASE_URL=https://api.moonshot.cn/v1
# DEEPEVAL_MODEL=moonshot-v1-8k

# --- 智谱 ---
# DEEPEVAL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DEEPEVAL_MODEL=glm-4-plus

# --- 硅基流动 ---
# DEEPEVAL_BASE_URL=https://api.siliconflow.cn/v1
# DEEPEVAL_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- 本地 Ollama（无需 key；deepeval 用 OllamaModel，需要另行指定）---
# DEEPEVAL_BASE_URL=http://127.0.0.1:11434/v1
# DEEPEVAL_MODEL=qwen2.5:7b
