{"id": "8aeaf096-bd31-43bd-bcc4-d81e187ab6df", "seq_id": 1, "tenant_id": 2, "knowledge_id": "a90f3279-6e2a-4996-93a7-35d91bda2e3b", "knowledge_base_id": "b3d2db99-8e7b-45b5-b251-4deae3da5e6b", "tag_id": "", "content": "# 端侧模型压缩技术说明\n\n## 量化\n\n模型量化是把浮点权重映射为低比特整数的压缩技术，通常从 FP16 压到 INT8 甚至 INT4，\n可显著降低显存占用与访存带宽需求，常用于端侧推理加速。\n\n## 剪枝\n\n结构化剪枝按通道或注意力头移除冗余参数，配合再训练可恢复大部分精度。\n\n## 蒸馏\n\n知识蒸馏让小模型拟合大模型的输出分布，在延迟敏感场景下性价比高。\n", "content_revision": 0, "index_status": "ready", "last_editor_id": "", "chunk_index": 0, "is_enabled": true, "flags": 1, "status": 0, "start_at": 0, "end_at": 183, "pre_chunk_id": "", "next_chunk_id": "", "chunk_type": "text", "parent_chunk_id": "", "relation_chunks": null, "indirect_relation_chunks": null, "metadata": null, "content_hash": "", "image_info": "", "created_at": "2026-09-16T16:53:31.4513322+08:00", "updated_at": "2026-09-16T16:53:31.4513322+08:00", "deleted_at": null}
